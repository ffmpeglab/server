{
   "name": "ffmpeglab-server",
   "version": "0.3.0",
   "description": "",
   "author": "",
   "private": true,
   "license": "UNLICENSED",
   "scripts": {
      "build": "nest build",
      "format": "prettier --write \"src/**/*.ts\" && prettier --write \"sdk/**/*.ts\"",
      "start": "nest start",
      "start:dev": "nest start --watch",
      "start:debug": "nest start --debug --watch",
      "start:prod": "node dist/main",
      "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "migrations:gen": "yarn build && node ./node_modules/typeorm/cli -d dist/data-source.js migration:generate src/migrations/init",
      "migrations:dry": "node ./node_modules/typeorm/cli -d dist/data-source.js migration:show",
      "migrations:run": "node ./node_modules/typeorm/cli -d dist/data-source.js migration:run",
      "migrations:sql": "yarn build && node ./node_modules/typeorm/cli -d dist/data-source.js migration:generate migrations/init",
      "test": "jest",
      "test:watch": "jest --watch",
      "test:cov": "jest --coverage",
      "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
      "test:e2e": "jest --config ./test/jest-e2e.json",
      "sdk-ts": "openapi-generator-cli generate -i https://api.ffmpeglab.com/api-yaml -g typescript-fetch -o sdk/ts --openapi-generator-ignore-list 'README.md,package.json' --additional-properties=npmName=ffmpeglab-sdk,supportsES6=true,npmVersion=0.3.0,withInterfaces=true",
      "sdk-py": "openapi-generator-cli generate -i https://api.ffmpeglab.com/api-yaml -g python -o sdk/py --additional-properties=npmName=ffmpeglab-sdk,supportsES6=true,npmVersion=0.3.0,withInterfaces=true",
      "sdk-rust": "openapi-generator-cli generate -i https://api.ffmpeglab.com/api-yaml -g rust -o sdk/rust --additional-properties=npmName=ffmpeglab-sdk,supportsES6=true,npmVersion=0.3.0,withInterfaces=true",
      "sdk-go": "openapi-generator-cli generate -i https://api.ffmpeglab.com/api-yaml -g go -o sdk/go --additional-properties=npmName=ffmpeglab-sdk,supportsES6=true,npmVersion=0.3.0,withInterfaces=true",
      "typeorm": "typeorm-ts-node-commonjs",
      "postinstall": "patch-package"
   },
   "dependencies": {
      "@aws-sdk/client-s3": "^3.1095.0",
      "@aws-sdk/s3-request-presigner": "^3.1095.0",
      "@nestjs/common": "^11.0.1",
      "@nestjs/core": "^11.0.1",
      "@nestjs/platform-express": "^11.0.1",
      "@nestjs/swagger": "^11.4.6",
      "@nestjs/typeorm": "^11.0.3",
      "@openapitools/openapi-generator-cli": "^2.40.1",
      "@supabase/server": "^1.4.1",
      "@supabase/supabase-js": "^2.110.8",
      "@tus/s3-store": "^2.0.5",
      "@tus/server": "^2.4.3",
      "@types/multer": "^2.2.0",
      "dotenv": "^17.4.2",
      "ffmpeglab-sdk": "^0.3.14",
      "nestjs-pgmq": "^0.0.5",
      "patch-package": "^8.0.1",
      "postinstall-postinstall": "^2.1.0",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.1",
      "typeorm": "1.1.0"
   },
   "devDependencies": {
      "@eslint/eslintrc": "^3.2.0",
      "@eslint/js": "^9.18.0",
      "@nestjs/cli": "^11.0.0",
      "@nestjs/schematics": "^11.0.0",
      "@nestjs/testing": "^11.0.1",
      "@types/express": "^5.0.0",
      "@types/jest": "^30.0.0",
      "@types/node": "^26.1.1",
      "@types/supertest": "^7.0.0",
      "eslint": "^9.18.0",
      "eslint-config-prettier": "^10.0.1",
      "eslint-plugin-prettier": "^5.2.2",
      "globals": "^17.0.0",
      "jest": "^30.0.0",
      "prettier": "^3.4.2",
      "source-map-support": "^0.5.21",
      "supertest": "^7.0.0",
      "ts-jest": "^29.2.5",
      "ts-loader": "^9.5.2",
      "ts-node": "^10.9.2",
      "tsconfig-paths": "^4.2.0",
      "typescript": "^5.7.3",
      "typescript-eslint": "^8.20.0"
   },
   "jest": {
      "moduleFileExtensions": [
         "js",
         "json",
         "ts"
      ],
      "rootDir": "src",
      "testRegex": ".*\\.spec\\.ts$",
      "transform": {
         "^.+\\.(t|j)s$": "ts-jest"
      },
      "collectCoverageFrom": [
         "**/*.(t|j)s"
      ],
      "coverageDirectory": "../coverage",
      "testEnvironment": "node"
   }
}
