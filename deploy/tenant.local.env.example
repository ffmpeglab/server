# Copy to deploy/tenant.local.env. Seeded into the dev Vault that
# ./deploy/deploy.sh local runs, so the pods reach a real database.
# Gitignored. Without this file the values come from deploy/.env instead, and
# without that one too the run seeds placeholders - which still proves the Vault
# path, but leaves the pods with nothing to connect to.
#
# The keys are the tenant record's, exactly as the platform writes them.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_ID=
