# Copy to deploy/.env and fill in. Gitignored; never commit it.
# Every non-empty variable here becomes a key of the release's Secret.

# Postgres. FFmpegLab does not deploy one; point this at a database that exists.
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=postgres

# Image to deploy, resolved to a digest so a rebuilt tag still rolls the pods.
# Empty keeps whatever the chart pins.
IMAGE_TAG=latest

# TypeORM synchronize. On for a fresh database, off once the tables exist.
DB_MIGRATION_ENABLED=false

# Object storage. Without S3_ENDPOINT the file runner is not deployed.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_ID=

# on-prem only: storage for the directory render and file share.
DOCUMENT_STORAGE_CLASS=
DOCUMENT_EXISTING_CLAIM=
