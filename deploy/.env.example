# Copy to deploy/.env and fill in. Gitignored; never commit it.

# Vault holds the tenant record and the operator writes it into the cluster.
# This is the intended path: no credential passes through this file.
VAULT_ADDR=https://vault.example.com
VAULT_ROLE=ffmpeglab
TENANT_PATH=tenants/<userId>/<projectId>

# Optional, with defaults shown.
VAULT_METHOD=kubernetes
VAULT_MOUNT=kubernetes
VAULT_SECRET_MOUNT=secret
VAULT_REFRESH=60s

# Image to deploy, resolved to a digest so a rebuilt tag still rolls the pods.
IMAGE_TAG=latest

# Storage for render's working directory. Render replicas on several nodes need
# ReadWriteMany; see deploy/README.md.
DOCUMENT_ACCESS_MODE=ReadWriteOnce
# Empty uses the cluster's default storage class.
DOCUMENT_STORAGE_CLASS=
# A claim you created yourself; overrides the two settings above.
DOCUMENT_EXISTING_CLAIM=
